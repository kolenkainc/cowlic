# <ENV_KEY> <target>[@<GH_ENVIRONMENT>][:<REMOTE_NAME>]
# targets: gh-env-secret (needs @<environment>) | gh-secret | gh-variable | worker-secret
# Values come from the gitignored .env; this file holds names only.
# All ingest values are secrets of the GitHub environment "ingest" (restricted to master),
# never repo-level secrets/variables: ids stay masked in logs and branches cannot read them.
TG_BOT_TOKEN gh-env-secret@ingest
TG_BOT_TOKEN worker-secret
SUBSONIC_USER worker-secret
SUBSONIC_PASSWORD worker-secret
SPOTIFY_CLIENT_ID gh-env-secret@ingest
SPOTIFY_CLIENT_SECRET gh-env-secret@ingest
# Dedicated token with only D1:Edit on the account (NOT the broad personal token).
INGEST_CLOUDFLARE_API_TOKEN gh-env-secret@ingest:CLOUDFLARE_API_TOKEN
TG_CHANNEL_ID gh-env-secret@ingest
CLOUDFLARE_ACCOUNT_ID gh-env-secret@ingest
D1_DATABASE_ID gh-env-secret@ingest
