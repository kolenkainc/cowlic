# <ENV_KEY> <target>[:<REMOTE_NAME>]
# targets: gh-secret | gh-variable | worker-secret
# Values come from the gitignored .env; this file holds names only.
TG_BOT_TOKEN gh-secret
TG_BOT_TOKEN worker-secret
SUBSONIC_USER worker-secret
SUBSONIC_PASSWORD worker-secret
SPOTIFY_CLIENT_ID gh-secret
SPOTIFY_CLIENT_SECRET gh-secret
# Dedicated token with only D1:Edit on the account (NOT the broad personal token).
INGEST_CLOUDFLARE_API_TOKEN gh-secret:CLOUDFLARE_API_TOKEN
TG_CHANNEL_ID gh-variable
CLOUDFLARE_ACCOUNT_ID gh-variable
D1_DATABASE_ID gh-variable
