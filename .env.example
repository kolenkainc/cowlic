# Copy to .env (gitignored) and fill in. Never commit real values.
# Distribute with: scripts/sync-secrets.sh
# Format: KEY=value, verbatim. No inline comments, no escapes, no leading space after "=".
TG_BOT_TOKEN=
TG_CHANNEL_ID=
SUBSONIC_USER=
SUBSONIC_PASSWORD=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Narrow token: permission D1:Edit on the account only. Synced to GitHub as CLOUDFLARE_API_TOKEN.
INGEST_CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
# Optional, local use only (wrangler, ad-hoc work). Not synced anywhere.
CLOUDFLARE_API_TOKEN=
# Optional: ship the ingest run log to Grafana Cloud Loki (docs/local-ingest.md, "Shipping the run log"). Leave empty to disable.
# Loki push URL, shape https://<stack-host>.grafana.net
INGEST_GRAFANA_LOKI_URL=
# Loki user id of the stack.
INGEST_GRAFANA_LOKI_USER=
# Grafana Cloud access token (shared by the logs and metrics shipping).
INGEST_GRAFANA_TOKEN=
# Optional: ship run metrics via the Influx endpoint of the Grafana Cloud Prometheus stack. Leave empty to disable.
# Prometheus stack URL, shape https://<stack-host>.grafana.net
INGEST_GRAFANA_PROM_URL=
# Prometheus stack user id.
INGEST_GRAFANA_PROM_USER=
# Optional: Last.fm read-only API key, used by the Last.fm report and the lastfm_artists source. Leave empty to disable.
LASTFM_API_KEY=
