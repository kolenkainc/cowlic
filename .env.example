# Copy to .env (gitignored) and fill in. Never commit real values.
# Distribute with: scripts/sync-secrets.sh
TG_BOT_TOKEN=
TG_CHANNEL_ID=
SUBSONIC_USER=
SUBSONIC_PASSWORD=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Narrow token: permission D1:Edit on the account only. Synced to GitHub as CLOUDFLARE_API_TOKEN.
INGEST_CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
# Optional, local use only (wrangler, ad-hoc work). Not synced anywhere.
CLOUDFLARE_API_TOKEN=
